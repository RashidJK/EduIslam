# Copy to .env.local and fill in. Never commit real values.
# Every variable is optional: without Supabase the app runs in local "device-only" mode,
# storing learning data in this browser only.

# Supabase (enables accounts, cloud sync, and the admin CMS).
# The anon key is a public client key; it is safe in the browser ONLY because every
# table is protected by row-level security (see supabase/migrations).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Quran text/translation/audio provider. Only "alquran-cloud" is implemented today.
# Audio URLs always come from the provider's responses; they are never constructed.
# See docs/SOURCES.md for licence terms before any commercial launch.
VITE_QURAN_PROVIDER=alquran-cloud
VITE_QURAN_API_BASE=https://api.alquran.cloud/v1

# Server-side only (never prefix with VITE_). Used by scripts/admin tooling, not the browser.
# SUPABASE_SERVICE_ROLE_KEY=
